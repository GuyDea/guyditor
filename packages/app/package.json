{
  "name": "@guyditor/app",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/setup-caption-font.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node ../../scripts/setup-caption-font.mjs",
    "build": "electron-vite build",
    "postbuild": "node scripts/stage-caption-font.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron.vite.config.ts e2e",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@guyditor/agent": "workspace:*",
    "@guyditor/compositor": "workspace:*",
    "@guyditor/core": "workspace:*",
    "@guyditor/deliver": "workspace:*",
    "@guyditor/media": "workspace:*",
    "@guyditor/render": "workspace:*",
    "@guyditor/transcript": "workspace:*",
    "@napi-rs/canvas": "1.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.14",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
