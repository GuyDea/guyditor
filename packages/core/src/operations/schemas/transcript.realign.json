{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "updates", "alignment", "jobId"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
    "wordRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromWord", "toWord"],
      "properties": {
        "fromWord": { "$ref": "#/$defs/wordId" },
        "toWord": { "$ref": "#/$defs/wordId" }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wordId", "start", "end", "confidence", "alignment"],
        "properties": {
          "wordId": { "$ref": "#/$defs/wordId" },
          "start": { "$ref": "#/$defs/sampleTime" },
          "end": { "$ref": "#/$defs/sampleTime" },
          "confidence": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "alignment": {
            "enum": ["ctc", "asr", "interpolated", "manual", "imported"]
          }
        }
      }
    },
    "alignment": {
      "oneOf": [
        { "$ref": "#/$defs/engine" },
        { "type": "null" }
      ]
    },
    "provisional": { "type": ["boolean", "null"] },
    "jobId": { "type": "string", "pattern": "^job_[a-z2-7]{10}$" }
  },
  "$defs": {
    "wordId": { "type": "string", "pattern": "^w[0-9]{6}$" },
    "sampleTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "rate"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rate": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
