{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cachedPath", "asset", "provenance", "review", "placement"],
  "properties": {
    "cachedPath": { "type": "string", "minLength": 1 },
    "asset": { "type": "object" },
    "provenance": { "type": "object" },
    "review": { "type": "object" },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequenceId", "layerId", "itemId", "atFrame", "durationFrames"],
      "properties": {
        "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
        "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
        "itemId": { "type": "string", "pattern": "^gfx_[a-z2-7]{10}$" },
        "atFrame": { "type": "integer", "minimum": 0 },
        "durationFrames": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
