{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["layerId"],
  "properties": {
    "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
    "fromFrame": { "type": "integer", "minimum": 0 },
    "toFrame": { "type": "integer", "minimum": 0 }
  }
}
