{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliverableId", "targets"],
  "properties": {
    "deliverableId": { "type": "string", "pattern": "^dlv_[a-z2-7]{10}$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["metadata", "chapters"] }
    }
  }
}
