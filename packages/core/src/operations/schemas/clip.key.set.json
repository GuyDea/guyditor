{
  "$id": "guyditor:op/clip.key.set",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["clipId", "settings"],
  "additionalProperties": false,
  "properties": {
    "clipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" },
    "effectId": { "type": "string", "pattern": "^fx_[a-z2-7]{10}$" },
    "settings": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/keySettings" }
      ]
    }
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "color": {
      "type": "object", "additionalProperties": false,
      "required": ["exposure", "contrast", "saturation"],
      "properties": {
        "exposure": { "type": "number", "minimum": -4, "maximum": 4 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 2 },
        "temperatureK": { "type": "number", "minimum": 1000, "maximum": 40000 },
        "tint": { "type": "number", "minimum": -1, "maximum": 1 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "mask": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "shape", "points", "featherPx"],
      "properties": {
        "id": { "type": "string", "pattern": "^msk_[a-z2-7]{10}$" },
        "role": { "enum": ["garbage", "holdout"] },
        "shape": { "enum": ["rect", "ellipse", "polygon"] },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "featherPx": { "type": "number", "minimum": 0 },
        "frames": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {
            "from": { "type": "integer", "minimum": 0 },
            "to": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "chroma": {
      "type": "object", "additionalProperties": false,
      "required": ["keyColor", "tolerance", "softness", "preBlur", "edge", "spill"],
      "properties": {
        "keyColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "softness": { "type": "number", "minimum": 0, "maximum": 1 },
        "preBlur": { "type": "number", "minimum": 0, "maximum": 4 },
        "edge": {
          "type": "object", "additionalProperties": false, "required": ["erodePx", "featherPx"],
          "properties": {
            "erodePx": { "type": "integer", "minimum": 0 },
            "featherPx": { "type": "number", "minimum": 0 }
          }
        },
        "spill": {
          "type": "object", "additionalProperties": false, "required": ["mode", "strength"],
          "properties": {
            "mode": { "enum": ["off", "despill", "average"] },
            "strength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "neural": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "downsampleRatio", "stabilization"],
      "properties": {
        "model": { "enum": ["rvm_mobilenetv3", "rvm_resnet50"] },
        "matteAssetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
        "downsampleRatio": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "stabilization": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "alphaMin", "motionGain", "minSpeckleArea"],
          "properties": {
            "enabled": { "type": "boolean" },
            "alphaMin": { "type": "number", "minimum": 0, "maximum": 1 },
            "motionGain": { "type": "number", "minimum": 0 },
            "minSpeckleArea": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "keySettings": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "mode", "masks"],
      "properties": {
        "schema": { "const": "guyditor/key@1" },
        "mode": { "enum": ["off", "chroma", "neural"] },
        "chroma": { "$ref": "#/$defs/chroma" },
        "neural": { "$ref": "#/$defs/neural" },
        "masks": { "type": "array", "items": { "$ref": "#/$defs/mask" } },
        "postColor": { "$ref": "#/$defs/color" }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "chroma" } }, "required": ["mode"] }, "then": { "properties": { "chroma": {} }, "required": ["chroma"] } },
        { "if": { "properties": { "mode": { "const": "neural" } }, "required": ["mode"] }, "then": { "properties": { "neural": {} }, "required": ["neural"] } }
      ]
    }
  }
}
