{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetIds"],
  "properties": {
    "assetIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
      "uniqueItems": true
    },
    "restoreAssets": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
