{
  "$id": "guyditor:op/layer.ducking.override",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["layerId", "points"],
  "properties": {
    "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
    "points": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "gainDb"],
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^(ann:ann_[a-z2-7]{10}|(word:w[0-9]{6}(#(start|end))?|beat:beat_[a-z2-7]{10}|clip:clp_[a-z2-7]{10}@[0-9]+|timeline:(seq_[a-z2-7]{10}@[0-9]+|[0-9]+@[0-9]+/[1-9][0-9]*))([+-][0-9]+)?)$"
          },
          "gainDb": { "type": "number", "minimum": -96, "maximum": 24 }
        }
      }
    }
  }
}
