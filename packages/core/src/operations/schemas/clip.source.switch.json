{
  "$id": "guyditor:op/clip.source.switch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["clipId", "assetId", "synchronizedTo"],
  "properties": {
    "clipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" },
    "assetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
    "synchronizedTo": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" }
  }
}
