{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotationId", "patch"],
  "properties": {
    "annotationId": { "type": "string", "pattern": "^ann_[a-z2-7]{10}$" },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "shape": true,
        "body": true,
        "style": true,
        "geometry": true,
        "anchor": true,
        "extent": true,
        "canvasRef": true,
        "sourceProjection": true,
        "blocking": true,
        "context": true
      }
    }
  }
}
