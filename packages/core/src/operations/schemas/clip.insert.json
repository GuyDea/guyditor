{
  "$id": "guyditor:op/clip.insert",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sequenceId", "index", "source", "layerId"],
  "additionalProperties": false,
  "properties": {
    "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
    "index": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["assetId", "in", "out"],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
        "in": { "$ref": "#/$defs/frameTime" },
        "out": { "$ref": "#/$defs/frameTime" }
      }
    },
    "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
    "clipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" },
    "restore": { "type": "object", "additionalProperties": true },
    "followingClipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" },
    "followingGapBefore": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/frameTime" }
      ]
    },
    "evidence": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "frameTime": {
      "type": "object",
      "required": ["frames", "fps"],
      "additionalProperties": false,
      "properties": {
        "frames": { "type": "integer", "minimum": 0 },
        "fps": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
      }
    }
  }
}
