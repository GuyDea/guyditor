{
  "$id": "guyditor:op/clip.audio.offset.set",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["clipId", "offset"],
  "properties": {
    "clipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" },
    "offset": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["samples", "rate"],
          "properties": {
            "samples": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "rate": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      ]
    }
  }
}
