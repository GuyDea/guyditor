{
  "$id": "guyditor:op/asset.markers.attach",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "markerIds", "sidecar"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
    "markerIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mrk_[a-z2-7]{10}$" }
    },
    "sidecar": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^sidecars/takes/ast_[a-z2-7]{10}\\.takes\\.json$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    }
  }
}
