{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packagePath": { "type": "string", "minLength": 1 },
    "builtinName": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "required": ["packagePath"],
      "properties": {
        "packagePath": { "type": "string", "minLength": 1 },
        "builtinName": false
      }
    },
    {
      "required": ["builtinName"],
      "properties": {
        "packagePath": false,
        "builtinName": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
