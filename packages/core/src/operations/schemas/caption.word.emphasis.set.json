{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["captionId", "wordId", "emphasis"],
  "properties": {
    "captionId": { "type": "string", "pattern": "^cts_[a-z2-7]{10}$" },
    "wordId": { "type": "string", "pattern": "^w[0-9]{6}$" },
    "emphasis": { "type": "boolean" }
  }
}
