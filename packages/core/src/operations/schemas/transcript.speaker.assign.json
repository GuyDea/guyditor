{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 2,
  "required": ["speakerId"],
  "properties": {
    "speakerId": { "type": "string", "pattern": "^spk_[a-z2-7]{10}$" },
    "segmentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^seg_[a-z2-7]{10}$" }
    },
    "wordRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromWord", "toWord"],
      "properties": {
        "fromWord": { "$ref": "#/$defs/wordId" },
        "toWord": { "$ref": "#/$defs/wordId" }
      }
    }
  },
  "$defs": { "wordId": { "type": "string", "pattern": "^w[0-9]{6}$" } }
}
