{
  "$id": "guyditor:op/deliverable.derive",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "profile", "from"],
  "properties": {
    "kind": { "const": "short" },
    "name": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profileOverrides": { "type": "object" },
    "candidateId": { "type": "string", "minLength": 1 },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "words": { "$ref": "#/$defs/wordRange" },
        "clips": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" } },
        "beats": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^beat_[a-z2-7]{10}$" } },
        "timelineRange": { "$ref": "#/$defs/timelineRange" }
      }
    },
    "resolvedSources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRange" } },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverableId", "sequenceId", "layerId", "captionsTrackId", "clipIds"],
      "properties": {
        "deliverableId": { "type": "string", "pattern": "^dlv_[a-z2-7]{10}$" },
        "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
        "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
        "additionalLayerIds": { "type": "array", "items": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" } },
        "captionsTrackId": { "type": "string", "pattern": "^cts_[a-z2-7]{10}$" },
        "clipIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" } }
      }
    }
  },
  "$defs": {
    "frameTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "fps"],
      "properties": {
        "frames": { "type": "integer", "minimum": 0 },
        "fps": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)/[1-9][0-9]*$" }
      }
    },
    "wordRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startWordId", "endWordId"],
      "properties": {
        "startWordId": { "type": "string", "pattern": "^w[0-9]{6}$" },
        "endWordId": { "type": "string", "pattern": "^w[0-9]{6}$" }
      }
    },
    "timelineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequenceId", "start", "end"],
      "properties": {
        "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
        "start": { "$ref": "#/$defs/frameTime" },
        "end": { "$ref": "#/$defs/frameTime" }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "range"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^ast_[a-z2-7]{10}$" },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/frameTime" },
            "end": { "$ref": "#/$defs/frameTime" }
          }
        },
        "words": { "$ref": "#/$defs/wordRange" },
        "longformClipId": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" }
      }
    }
  }
}
