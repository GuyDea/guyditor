{
  "$id": "guyditor:op/anchor.rebind",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["owner", "anchorPath", "newAnchor"],
  "additionalProperties": false,
  "properties": {
    "owner": {
      "type": "string",
      "pattern": "^(beat|clp|gfx)_[a-z2-7]{10}$"
    },
    "anchorPath": {
      "enum": ["/anchor", "/at", "/duration/until"]
    },
    "newAnchor": {
      "type": "string",
      "pattern": "^(ann:ann_[a-z2-7]{10}|(word:w[0-9]{6}(#(start|end))?|beat:beat_[a-z2-7]{10}|clip:clp_[a-z2-7]{10}@[0-9]+|timeline:(seq_[a-z2-7]{10}@[0-9]+|[0-9]+@[0-9]+/[1-9][0-9]*))([+-][0-9]+)?)$"
    },
    "lastResolved": { "$ref": "#/$defs/lastResolved" }
  },
  "$defs": {
    "frameTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "fps"],
      "properties": {
        "frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "fps": { "type": "string", "pattern": "^[0-9]+/[1-9][0-9]*$" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wordsBefore", "wordsAfter"],
      "properties": {
        "wordsBefore": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "wordsAfter": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
      }
    },
    "lastResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline", "revision"],
      "properties": {
        "timeline": { "$ref": "#/$defs/frameTime" },
        "revision": { "type": "string", "pattern": "^rev_[0-9]{5}$" },
        "context": { "$ref": "#/$defs/context" }
      }
    }
  }
}
