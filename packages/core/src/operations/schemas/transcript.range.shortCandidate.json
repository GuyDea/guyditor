{
  "$id": "guyditor:op/transcript.range.shortCandidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["wordRange"],
      "additionalProperties": false,
      "properties": {
        "wordRange": {
          "type": "object",
          "required": ["fromWord", "toWord"],
          "additionalProperties": false,
          "properties": {
            "fromWord": { "type": "string", "pattern": "^w[0-9]{6}$" },
            "toWord": { "type": "string", "pattern": "^w[0-9]{6}$" }
          }
        },
        "title": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "created": {
          "type": "object",
          "required": ["deliverableId", "sequenceId", "layerId", "captionsTrackId", "clipIds"],
          "additionalProperties": false,
          "properties": {
            "deliverableId": { "type": "string", "pattern": "^dlv_[a-z2-7]{10}$" },
            "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
            "layerId": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" },
            "additionalLayerIds": { "type": "array", "items": { "type": "string", "pattern": "^lyr_[a-z2-7]{10}$" } },
            "captionsTrackId": { "type": "string", "pattern": "^cts_[a-z2-7]{10}$" },
            "clipIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clp_[a-z2-7]{10}$" } }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["removeCandidateId"],
      "additionalProperties": false,
      "properties": {
        "removeCandidateId": { "type": "string", "pattern": "^dlv_[a-z2-7]{10}$" }
      }
    }
  ]
}
