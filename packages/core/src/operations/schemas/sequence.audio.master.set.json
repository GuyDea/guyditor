{
  "$id": "guyditor:op/sequence.audio.master.set",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["sequenceId", "targetLufs", "truePeakDb"],
  "properties": {
    "sequenceId": { "type": "string", "pattern": "^seq_[a-z2-7]{10}$" },
    "targetLufs": { "type": ["number", "null"] },
    "truePeakDb": { "type": ["number", "null"] }
  }
}
